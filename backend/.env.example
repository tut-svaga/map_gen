# Скопируй в .env и подставь свои значения. Сам .env в репозиторий не коммитится.
# Подключение к контейнерам: docker run --env-file backend/.env ...

# Имя контейнера MySQL в user-defined сети (в ней оно же — DNS-имя), напр. cont-mysql
DB_HOST=
DB_PORT=3306
# Совпадает с MYSQL_DATABASE контейнера базы
DB_NAME=
# Совпадают с MYSQL_USER / MYSQL_PASSWORD; root приложению не нужен
DB_USER=
DB_PASSWORD=

# Порт HTTP-сервера приложения
PORT=3000

# Окно заморозки направления, YYYY-MM-DD. Необязательные:
# без них берутся значения по умолчанию из config/freeze.js.
FREEZE_START=2026-08-06
FREEZE_END=2026-11-06
