{
  "name": "roadmap-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for personal roadmap progress tracker and freeze tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "supertest": "^7.0.0"
  }
}
